# MongoDB
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@semob.tua8uo7.mongodb.net/projetobus?retryWrites=true&w=majority&appName=SEMOB

# IA (OpenRouter - https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui
IA_MODELO=inclusionai/ling-3.0-flash-vl:free

# Servidor
PORT=3000

# Caixa de e-mail dos funcionários (Gmail grátis via IMAP)
EMAIL_USUARIO=projetobus.operacao@gmail.com
EMAIL_SENHA=sua-senha-de-app
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORTA=993
EMAIL_INTERVALO_SEGUNDOS=60
EMAIL_REMETENTES_IGNORADOS=no-reply@accounts.google.com,no-reply@google.com,mailer-daemon@googlemail.com

# Kafka (Aiven) - deixe KAFKA_BROKER vazio para desabilitar
KAFKA_BROKER=seu-kafka-projeto.aivencloud.com:12345
KAFKA_TOPICO_EMAILS=emails-recebidos
# Autenticação por certificado (padrão Aiven)
KAFKA_CA=certificados/ca.pem
KAFKA_CERT=certificados/service.cert
KAFKA_KEY=certificados/service.key
# Ou autenticação SASL (usuário/senha)
KAFKA_SASL_USUARIO=
KAFKA_SASL_SENHA=

# Webhook Secret (opcional)
WEBHOOK_SECRET=seu-secret-aqui
